        </mxCell>

        <!-- NO: Not found -->
        <mxCell id="n-notfound" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="Print message:&lt;br&gt;&amp;quot;Shop with this address was not found&amp;quot;" vertex="1">
