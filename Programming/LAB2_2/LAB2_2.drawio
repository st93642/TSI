        <!-- ── Prompt address ── -->
        <mxCell id="n-prompt" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="Print &amp;quot;Enter address: &amp;quot;&lt;br&gt;prompt to console" vertex="1">
