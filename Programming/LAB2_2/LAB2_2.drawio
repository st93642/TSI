        <!-- ── i &lt; count? ── -->
        <mxCell id="n-loop" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="i &amp;lt; count?" vertex="1">
