        <!-- YES: Empty -->
        <mxCell id="n-emptymsg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="Print message:&lt;br&gt;&amp;quot;File is empty or does not exist&amp;quot;" vertex="1">
          <mxGeometry x="560" y="100" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-empty-emptymsg" edge="1" parent="1" source="n-empty" target="n-emptymsg" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
