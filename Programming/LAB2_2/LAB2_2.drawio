        <mxCell id="n-strcmp" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="std::strcmp(&lt;br&gt;shops[i].address,&lt;br&gt;address) == 0?" vertex="1">
          <mxGeometry x="300" y="660" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-loop-strcmp" edge="1" parent="1" source="n-loop" target="n-strcmp" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- YES: Show telephone -->
        <mxCell id="n-showtel" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="Print telephone number:&lt;br&gt;shops[i].phone" vertex="1">
