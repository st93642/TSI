        </mxCell>
        <mxCell id="e-empty-prompt" edge="1" parent="1" source="n-empty" target="n-prompt" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ── Read address ── -->
        <mxCell id="n-readaddr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="Read address via&lt;br&gt;std::cin.getline(address, 128)" vertex="1">
          <mxGeometry x="260" y="330" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-prompt-readaddr" edge="1" parent="1" source="n-prompt" target="n-readaddr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ── i = 0 ── -->
        <mxCell id="n-init" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=12;" value="i = 0" vertex="1">
